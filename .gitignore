# Raw captures and processing data (hundreds of GB, not source)
/Capture/
/Sun/
/umbra/
/out/
/swap/

# Python bytecode
__pycache__/
*.pyc

# Virtualenv. uv.lock is COMMITTED, deliberately: without it nobody else
# resolves the same dependency versions you did, and "works on my machine" is
# the failure this repository is trying not to have.
.venv/

# Build output
/build/
/dist/
*.egg-info/

# Test and tooling caches
.pytest_cache/
.ruff_cache/
